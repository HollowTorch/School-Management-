{
  "info": {"name": "Multi-School Management System API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key":"baseUrl","value":"http://localhost:8080"},{"key":"token","value":""},{"key":"schoolId","value":"1"},{"key":"studentId","value":"1"},{"key":"guardianId","value":"1"},{"key":"qrToken","value":"paste-token-from-qr-issue"}],
  "item": [
    {"name":"Health","request":{"method":"GET","url":"{{baseUrl}}/api/v1/health"}},
    {"name":"Initial setup (run once)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"schoolName\": \"Demo School\",\n  \"schoolCode\": \"DEMO01\",\n  \"adminName\": \"School Admin\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"ChangeMe123!\"\n}"},"url":"{{baseUrl}}/api/v1/setup/initial-school"}},
    {"name":"Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"admin@example.com\",\n  \"password\": \"ChangeMe123!\",\n  \"schoolId\": 1\n}"},"url":"{{baseUrl}}/api/v1/auth/login"}},
    {"name":"Create student","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\n  \"admissionNumber\": \"STU-001\",\n  \"firstName\": \"Ama\",\n  \"lastName\": \"Mensah\"\n}"},"url":"{{baseUrl}}/api/v1/students"}},
    {"name":"Create guardian","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\n  \"fullName\": \"Parent Name\",\n  \"phone\": \"233XXXXXXXXX\",\n  \"email\": \"parent@example.com\"\n}"},"url":"{{baseUrl}}/api/v1/guardians"}},
    {"name":"Issue student QR","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/v1/qr/students/{{studentId}}"}},
    {"name":"Record arrival","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\n  \"qrToken\": \"{{qrToken}}\",\n  \"eventType\": \"ARRIVAL\",\n  \"idempotencyKey\": \"arrival-demo-001\"\n}"},"url":"{{baseUrl}}/api/v1/attendance/scan"}},
    {"name":"Attendance history","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/v1/attendance"}}
  ]
}
